# Server
NODE_ENV=development
PORT=5000

# MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017/laxmi_agro

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# File storage
# Use "local" for local development, "firebase" for production Firebase storage, or "auto" to prefer Firebase when configured.
FILE_STORAGE_DRIVER=local
LOCAL_UPLOADS_DIR=uploads
PUBLIC_BASE_URL=http://localhost:5000

# Firebase (optional for local dev; required for push notifications & hosted storage)
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYour-Private-Key\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@your-project.iam.gserviceaccount.com
FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app

# Business UPI (default, can be changed via settings)
DEFAULT_UPI_ID=laxmiagro@ybl
DEFAULT_UPI_NAME=Laxmi Agro Payments

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=200

# Frontend URLs (for CORS)
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000,http://<YOUR_LAN_IP>:3000
ADMIN_PANEL_URL=http://localhost:3000
MOBILE_APP_DEEP_LINK=laxmiagro://

# Admin Magic Link Login
# Comma-separated fixed admin emails that can receive magic links
ADMIN_EMAILS=abhinavpandey12201@gmail.com,mayurkhatwani5@gmail.com
MAGIC_LINK_EXPIRY_MINUTES=5

# SMTP (for magic link emails; leave empty in dev to log links to console)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-gmail-app-password
EMAIL_FROM=your-email@gmail.com
