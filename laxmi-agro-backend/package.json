{
  "name": "laxmi-agro-backend",
  "version": "1.0.0",
  "description": "Laxmi Agro E-Commerce API",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "seed": "node src/scripts/seed.js",
    "seed:admin": "node src/scripts/seedAdmin.js",
    "seed:local": "node src/scripts/seedLocalCatalog.js",
    "catalog:pdf": "node src/scripts/importPdfCatalog.js",
    "products:remove-variants": "node src/scripts/removeProductVariants.js",
    "products:clean-names": "node src/scripts/cleanProductNames.js",
    "products:split-pump-categories": "node src/scripts/splitPumpCategories.js",
    "products:sync-shivnath-kq": "node src/scripts/syncShivnathKQCategories.js",
    "payments:remove-razorpay": "CONFIRM_RAZORPAY_CLEANUP=1 node src/scripts/removeRazorpayData.js",
    "media:audit-private": "node src/scripts/auditPrivateMediaMigration.js",
    "media:migrate-private": "node src/scripts/migratePrivateMedia.js",
    "media:rollback-private": "PRIVATE_MEDIA_MIGRATION_MODE=rollback node src/scripts/migratePrivateMedia.js",
    "test": "node tests/inventory.test.js",
    "test:price-snapshot": "node tests/priceSnapshotWorkbook.test.js"
  },
  "keywords": [
    "ecommerce",
    "agriculture",
    "wholesale",
    "api"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "axios": "^1.13.4",
    "bcryptjs": "^2.4.3",
    "blurhash": "^2.0.5",
    "cloudinary": "^1.41.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "exceljs": "^4.4.0",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "firebase-admin": "^12.0.0",
    "helmet": "^7.1.0",
    "joi": "^17.11.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.0.3",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "multer-storage-cloudinary": "^4.0.0",
    "nodemailer": "^9.0.3",
    "sharp": "^0.34.5",
    "slugify": "^1.6.6",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "nodemon": "^3.0.2"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
